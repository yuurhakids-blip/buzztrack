# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# VITE_API_BASE: Client-side API base URL (optional).
VITE_API_BASE=""

# Twitter (X) API Credentials (for OAuth on the frontend)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_BEARER_TOKEN=""

# Twitter Scraper (twscrape) - cookies from browser (auth_token=xxx; ct0=yyy)
# Get from: x.com -> DevTools -> Application -> Cookies
TWITTER_COOKIES=""

# YouTube Data API Credentials
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# TikTok Developer API Credentials
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

# TikTok Scraper (TikTokApi) - ms_token from browser cookies
# Get from: tiktok.com -> DevTools -> Application -> Cookies
TIKTOK_MS_TOKEN=""

# OpenRouter API Key (alternative to Gemini)
OPENROUTER_API_KEY=""

# Pre-connected Social Media Usernames (optional)
X_USERNAME=""
YOUTUBE_USERNAME=""
TIKTOK_USERNAME=""
